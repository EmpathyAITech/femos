{
  "id": "femos-device-registry",
  "version": "0.1.0",
  "note": "FEMOS Kit compatibility registry. FEMOS adds software to the devices clinics already own; it ships no proprietary sensor. A device is listed as validated after the docs/KIT.md protocol has been run on physical units. Model details and prices are planning information to confirm with manufacturers and local suppliers before procurement.",
  "statusLegend": {
    "validated": "Tested on physical units under the docs/KIT.md protocol; results published.",
    "bench-tested": "Adapter tested on the FEMOS benchmark suite (generated display images or specification byte vectors).",
    "implemented": "Adapter code exists; not yet tested against this model.",
    "planned": "On the roadmap; no adapter yet.",
    "manual-only": "Use typed entry with double-entry confirmation."
  },
  "captureModes": {
    "camera_ocr": "Photo of the device display, read on the phone, confirmed by a person. Works with any device that has a numeric display.",
    "ble_gatt": "Bluetooth Low Energy using the standard Bluetooth SIG health profiles (Blood Pressure 0x1810, Glucose 0x1808, Health Thermometer 0x1809). Only devices that implement the standard profile.",
    "usb_serial": "Wired export where the manufacturer documents the protocol and permits use.",
    "lab_file": "CSV / HL7 v2 / FHIR / supported PDF reports from labs, with identity reconciliation.",
    "manual": "Typed entry, entered twice to confirm."
  },
